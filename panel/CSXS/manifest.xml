<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.prpack.panel"
                   ExtensionBundleVersion="0.2.1"
                   ExtensionBundleName="prpack">
  <ExtensionList>
    <Extension Id="com.prpack.panel.main" Version="0.2.1"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- PPRO 14.0 = Premiere Pro 2020，向上兼容到 2026 -->
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.prpack.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>prpack 工程打包</Menu>
          <Geometry>
            <Size>
              <Height>620</Height>
              <Width>440</Width>
            </Size>
            <MinSize>
              <Height>420</Height>
              <Width>360</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
